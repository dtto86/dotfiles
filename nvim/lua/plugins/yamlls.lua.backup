return {
    "neovim/nvim-lspconfig",
    opts = {
      servers = {
        yamlls = {
          settings = {
            yaml = {
              keyOrdering = false, -- optional
              format = { enable = true },
            },
          },
        },
      },
      setup = {
        yamlls = function(server, opts)
          local schemas = opts.settings.yaml.schemas or {}

          table.insert(schemas, {
            ["https://json.schemastore.org/github-workflow.json"] = { "openapi.json", "openapi.yml", "openapi.yml" },
          })

          -- table.insert(schemas, {
          --   ["https://json.schemastore.org/docker-compose.json"] = "docker-compose*.yml",
          -- })

          opts.settings.yaml.schemas = schemas

          require("lspconfig")[server].setup(opts)
          return true
        end,
      },
    },
}

